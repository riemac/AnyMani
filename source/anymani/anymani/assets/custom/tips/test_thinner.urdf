<!-- 同一 link 下多个 collision 几何重叠，本身通常不会触发“自碰撞”；它们会一起构成这个 link 的复合碰撞体 -->
<!-- 真正的风险不在“它们彼此撞上了”，而在“它们一起和外界接触时，接触法向、接触点数量、等效接触刚度变脏” -->
<!-- <inertial> 不写，Isaac Lab/Isaac Sim 不会简单把 link 变成“零质量不可动”，但会进入 importer/PhysX 的兜底逻辑；对指尖这种接触敏感部件，我不建议依赖这个兜底。 -->
<robot name="test">
  <link name="base_link"/>

  <joint name="tip_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tip"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tip">
    <visual>
      <!-- thinner tip 标定探针：使用安装底面正方形中心作为锚点。
           整体 STL 外接盒的 x 范围约为 0..20.997mm，但这会把上半部分 tip 轮廓也算入
           安装底面高度。直接抽取 STL 中 y=0 的安装面点集，得到 x=0..19mm、
           z=-33..0mm，因此锚点取 p*=(9.5,0,-16.5)。沿用 custom tip canonical 约定：
           scale=0.001，
           rpy=(0,-pi/2,0)，使安装底面中心对齐 joint 原点，tip 生长方向落到 +y。 -->
      <origin xyz="-0.0165 0 -0.0095" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="thinner_finger_tip_soft.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0165 0 -0.0095" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="thinner_finger_tip_soft.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
</robot>
