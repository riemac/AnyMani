<!-- 同一 link 下多个 collision 几何重叠，本身通常不会触发“自碰撞”；它们会一起构成这个 link 的复合碰撞体 -->
<!-- 真正的风险不在“它们彼此撞上了”，而在“它们一起和外界接触时，接触法向、接触点数量、等效接触刚度变脏” -->
<!-- <inertial> 不写，Isaac Lab/Isaac Sim 不会简单把 link 变成“零质量不可动”，但会进入 importer/PhysX 的兜底逻辑；对指尖这种接触敏感部件，我不建议依赖这个兜底。 -->
<robot name="test">
  <link name="base_link"/>

  <joint name="tip_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tip"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tip">
    <visual>
      <!-- leap cube 版：finger_tip_soft.stl 的底层中心对齐 joint 原点；y 轴从底部指向指尖。
           这个版本里 y 轴已经对了，x 轴应当映射到 +z；剩下的 z 轴由右手系确定，因此这里绕 y 轴转 -pi/2。
           该 STL 以 mm 级网格坐标存储，因此这里使用 0.001 标定到 m 制世界；若后续再做尺寸缩放，只需在此基础上继续重算平移，不改 rpy。 -->
      <origin xyz="-0.0164999999586 0 -0.00948570692492" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="finger_tip_soft.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0164999999586 0 -0.00948570692492" rpy="0 -1.57079632679 0"/>
      <geometry>
        <mesh filename="finger_tip_soft.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
</robot>