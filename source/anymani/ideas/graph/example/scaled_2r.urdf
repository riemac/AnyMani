<?xml version='1.0' encoding='UTF-8'?>
<robot name="simple_2r">

  
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>

  
  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="link1" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3.14" />
  </joint>

  
  
  <link name="link1">
    <visual>
      <origin xyz="0.000000 0.000000 0.225000" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.450000" />
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.225000" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.450000" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 0.225000" rpy="0 0 0" />
      <mass value="1.526814" />
      <inertia ixx="0.02591767" ixy="0" ixz="0" iyy="0.02591767" iyz="0" izz="0.00030536" />
    </inertial>
  </link>

  
  
  <joint name="joint2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0.000000 0.000000 0.450000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3.14" />
  </joint>

  
  
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.2" />
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.2" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <mass value="0.382" />
      <inertia ixx="0.00130" ixy="0" ixz="0" iyy="0.00130" iyz="0" izz="0.0000430" />
    </inertial>
  </link>

</robot>